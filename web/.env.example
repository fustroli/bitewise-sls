AVATAR_UPLOAD_ORIGIN=https://bitewise-sls-avatars-<account-id>.s3.us-east-1.amazonaws.com
# Dev only: where `next dev` proxies `/api/*` (default: the app domain).
# DEV_API_ORIGIN=
