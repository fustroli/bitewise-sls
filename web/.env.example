NEXT_PUBLIC_USER_POOL_ID=us-east-1_mxizFmjKZ
NEXT_PUBLIC_USER_POOL_CLIENT_ID=3ar8dsh33uocuk57aml6imi8qr
NEXT_PUBLIC_COGNITO_DOMAIN=us-east-1mxizfmjkz.auth.us-east-1.amazoncognito.com
